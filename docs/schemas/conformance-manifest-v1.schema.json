{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankParser conformance manifest v1",
  "type": "object",
  "properties": {
    "manifest_schema_version": {
      "const": "1"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "expected": {
            "type": "string",
            "pattern": "\\S"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "policy_differences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "reason": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "required": [
                "path",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "source",
          "source_sha256",
          "expected",
          "expected_sha256",
          "evidence",
          "policy_differences"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "manifest_schema_version",
    "profile",
    "samples"
  ],
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "pattern": "\\S"
        },
        "exporter": {
          "type": "string",
          "pattern": "\\S"
        },
        "format": {
          "enum": [
            "csv",
            "mt940",
            "camt053",
            "ofx"
          ]
        },
        "format_version": {
          "type": "string",
          "pattern": "\\S"
        },
        "settings": {
          "type": "object",
          "properties": {
            "encoding": {
              "type": "string",
              "pattern": "\\S"
            },
            "account_type": {
              "type": "string",
              "pattern": "\\S"
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "locale": {
              "type": "string",
              "pattern": "\\S"
            },
            "date_convention": {
              "type": "string",
              "pattern": "\\S"
            },
            "amount_convention": {
              "type": "string",
              "pattern": "\\S"
            },
            "extra": {
              "type": "object"
            }
          },
          "required": [
            "encoding",
            "account_type",
            "currency",
            "locale",
            "date_convention",
            "amount_convention"
          ],
          "additionalProperties": false
        },
        "implementation": {
          "type": "string",
          "pattern": "\\S"
        },
        "csv_options": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "decimal_separator": {
                  "enum": [
                    null,
                    ".",
                    ","
                  ]
                },
                "grouping_separator": {
                  "enum": [
                    null,
                    ".",
                    ",",
                    " ",
                    "'"
                  ]
                },
                "date_format": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "exporter",
        "format",
        "format_version",
        "settings",
        "implementation",
        "csv_options"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "not": {
                  "const": "csv"
                }
              }
            }
          },
          "then": {
            "properties": {
              "csv_options": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "demo",
            "production"
          ]
        },
        "cohort": {
          "enum": [
            "development",
            "held-out"
          ]
        },
        "permission": {
          "type": "string",
          "pattern": "\\S"
        },
        "expectation_author": {
          "type": "string",
          "pattern": "\\S"
        },
        "expectation_method": {
          "type": "string",
          "pattern": "\\S"
        },
        "independent_reviewer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "held_out_untouched": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "cohort",
        "permission",
        "expectation_author",
        "expectation_method",
        "independent_reviewer",
        "held_out_untouched"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "held_out_untouched": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "cohort": {
                "const": "held-out"
              }
            }
          }
        }
      ]
    }
  }
}
