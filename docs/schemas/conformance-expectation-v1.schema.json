{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankParser frozen expectation v1",
  "type": "object",
  "properties": {
    "expectation_schema_version": {
      "const": "1"
    },
    "canonical_schema_version": {
      "const": "1.1"
    },
    "account": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "iban": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "iban",
        "currency"
      ],
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "opening_balance_currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "closing_balance_currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        },
        "opening_balance": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "closing_balance": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "sequence",
        "opening_balance_currency",
        "closing_balance_currency",
        "start_date",
        "end_date",
        "opening_balance",
        "closing_balance"
      ],
      "additionalProperties": false
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "booking_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
          },
          "value_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "transaction_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "counterparty": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "account_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "iban": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "account_id",
              "iban"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "booking_date",
          "value_date",
          "amount",
          "currency",
          "description",
          "reference",
          "transaction_id",
          "counterparty"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "expectation_schema_version",
    "canonical_schema_version",
    "account",
    "statement",
    "transactions"
  ],
  "additionalProperties": false
}
