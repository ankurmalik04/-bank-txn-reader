{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankParser conformance report v1",
  "type": "object",
  "properties": {
    "report_schema_version": {
      "const": "1"
    },
    "facts": {
      "type": "object",
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "canonical_schema_version": {
          "const": "1.1"
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "error"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              },
              "source_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expected_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "backend": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "implementation": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "implementation_version": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "bankparser_version": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "format",
                      "implementation",
                      "implementation_version",
                      "bankparser_version"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "counts": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "expected": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "actual": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "missing_count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "extra_count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "expected",
                      "actual",
                      "missing_count",
                      "extra_count"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "booked_totals": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "expected": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "currency": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "amount": {
                              "type": "string",
                              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
                            }
                          },
                          "required": [
                            "currency",
                            "amount"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "actual": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "currency": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "amount": {
                              "type": "string",
                              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
                            }
                          },
                          "required": [
                            "currency",
                            "amount"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "expected",
                      "actual"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fields_checked": {
                "type": "integer",
                "minimum": 0
              },
              "alignment": {
                "type": "string",
                "pattern": "\\S"
              },
              "differences": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "category": {
                      "enum": [
                        "financial",
                        "metadata",
                        "policy"
                      ]
                    },
                    "expected_present": {
                      "type": "boolean"
                    },
                    "actual_present": {
                      "type": "boolean"
                    },
                    "expected": {},
                    "actual": {},
                    "policy_reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "category",
                    "expected_present",
                    "actual_present",
                    "expected",
                    "actual",
                    "policy_reason"
                  ],
                  "additionalProperties": false
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "status": {
                      "enum": [
                        "passed",
                        "failed",
                        "skipped"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "parser_validation": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "passed",
                          "warning",
                          "failed"
                        ]
                      },
                      "checks": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "pattern": "\\S"
                            },
                            "status": {
                              "enum": [
                                "passed",
                                "failed",
                                "skipped"
                              ]
                            }
                          },
                          "required": [
                            "code",
                            "status"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "status",
                      "checks"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "warning_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "error": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "location": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "code",
                      "location",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "status",
              "evidence",
              "source_sha256",
              "expected_sha256",
              "backend",
              "counts",
              "booked_totals",
              "fields_checked",
              "alignment",
              "differences",
              "checks",
              "parser_validation",
              "warning_codes",
              "error"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "passed",
            "failed",
            "error"
          ],
          "additionalProperties": false
        },
        "certification": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "manifest_sha256",
        "profile",
        "canonical_schema_version",
        "samples",
        "summary",
        "certification"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "python": {
          "type": "string",
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "pattern": "\\S"
        },
        "bankparser_version": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "generated_at",
        "python",
        "platform",
        "bankparser_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "report_schema_version",
    "facts",
    "execution"
  ],
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "pattern": "\\S"
        },
        "exporter": {
          "type": "string",
          "pattern": "\\S"
        },
        "format": {
          "enum": [
            "csv",
            "mt940",
            "camt053",
            "ofx"
          ]
        },
        "format_version": {
          "type": "string",
          "pattern": "\\S"
        },
        "settings": {
          "type": "object",
          "properties": {
            "encoding": {
              "type": "string",
              "pattern": "\\S"
            },
            "account_type": {
              "type": "string",
              "pattern": "\\S"
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "locale": {
              "type": "string",
              "pattern": "\\S"
            },
            "date_convention": {
              "type": "string",
              "pattern": "\\S"
            },
            "amount_convention": {
              "type": "string",
              "pattern": "\\S"
            },
            "extra": {
              "type": "object"
            }
          },
          "required": [
            "encoding",
            "account_type",
            "currency",
            "locale",
            "date_convention",
            "amount_convention"
          ],
          "additionalProperties": false
        },
        "implementation": {
          "type": "string",
          "pattern": "\\S"
        },
        "csv_options": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "decimal_separator": {
                  "enum": [
                    null,
                    ".",
                    ","
                  ]
                },
                "grouping_separator": {
                  "enum": [
                    null,
                    ".",
                    ",",
                    " ",
                    "'"
                  ]
                },
                "date_format": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "version",
        "exporter",
        "format",
        "format_version",
        "settings",
        "implementation",
        "csv_options"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "not": {
                  "const": "csv"
                }
              }
            }
          },
          "then": {
            "properties": {
              "csv_options": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "demo",
            "production"
          ]
        },
        "cohort": {
          "enum": [
            "development",
            "held-out"
          ]
        },
        "permission": {
          "type": "string",
          "pattern": "\\S"
        },
        "expectation_author": {
          "type": "string",
          "pattern": "\\S"
        },
        "expectation_method": {
          "type": "string",
          "pattern": "\\S"
        },
        "independent_reviewer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "held_out_untouched": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "cohort",
        "permission",
        "expectation_author",
        "expectation_method",
        "independent_reviewer",
        "held_out_untouched"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "held_out_untouched": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "cohort": {
                "const": "held-out"
              }
            }
          }
        }
      ]
    }
  }
}
